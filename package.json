{
  "name": "desktop-pet-mvp",
  "version": "0.6.2",
  "description": "PingPet：一个安静住在 macOS 桌面上的小伙伴。注意 name 字段不可改动（它决定 userData 目录与钥匙串条目，改了老用户的设置和 API Key 全部对不上号），对外显示名见 electron-builder.yml 的 productName。",
  "main": "./out/main/main.js",
  "author": "czy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && electron-vite build",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@huggingface/transformers": "^4.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@electron/osx-sign": "^1.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
